POLYGON_PRIVATE_KEY=cc5a7523b69e8de45bb8e5233503d358fbce0c2bbfc360a5151526d3159e0aee
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/ttJkYMXVkirrBeMz4EKmY

# --- Polymarket Builder API Credentials ---
# Found at: https://polymarket.com/profile → Builders section
POLY_API_KEY=d60fd1f0-5b0d-5f6c-4bb8-e34377628b30
POLY_API_SECRET=kFEwcDxhIAa-yXYKE0_89xK45WrBd9MYb1obR0YvIz0=
POLY_API_PASSPHRASE=0a145ac04f2d6bb1386cdaf13abec987037db3146b7f48458ad2ec3363d730d8

# --- Trading Mode ---
# Set LIVE_TRADING=true ONLY after successful dry-run validation.
DRY_RUN=false
LIVE_TRADING=true

# --- Position Sizing (CAPITAL PROTECTION MODE — starting equity $10.93) ---
POSITION_SIZE_USD=1.05        # Clear the $1.00 exchange minimum size limit
MAX_POSITION_SIZE_USD=2.00    # Hard cap: no single trade exceeds $2.00
KELLY_FRACTION=0.15           # Conservative 15% Kelly — slow and steady

# --- Risk Controls (STRICT — cannot afford to lose this capital) ---
DAILY_STOP_LOSS_PCT=10.0      # Halt trading if down >10% in a day ($0.76)
MAX_DRAWDOWN_PCT=20.0         # Emergency stop if total equity drops >20% ($1.52)
MAX_OPEN_POSITIONS=6          # Never hold more than 6 positions simultaneously
MAX_RESOLUTION_DAYS=7         # Allow weekly markets — more opportunities

# --- Whale Tracker Settings ---
TOP_N_WHALES=5                # Number of whales to follow
WHALE_MIN_WIN_RATE=75         # Raised to 75% — only copy the very best
WHALE_MIN_VOLUME=10000        # Minimum total volume USD to qualify
WHALE_POLL_INTERVAL=60        # Seconds between trade polls per whale
LEADERBOARD_REFRESH_HOURS=6  # How often to refresh whale list

# --- Stink Bid Settings (tightened) ---
STINK_BID_ENABLED=true
STINK_BID_DISCOUNT=35         # Raised to 35% discount — only deep value
STINK_BID_MIN_PROB=0.70       # Only on strong favorites with >70% implied prob
STINK_BID_MAX_OPEN=2          # Max 2 concurrent stink bids (protect cash)

# --- Dashboard ---
DASHBOARD_PORT=5000
DASHBOARD_HOST=0.0.0.0

# --- Optional: AI Scoring (Gemini) ---
GEMINI_API_KEY=
AI_SCORING_ENABLED=false

# --- Logging ---
LOG_LEVEL=INFO                # DEBUG, INFO, WARNING, ERROR
LOG_FILE=data/bot.log

# --- Email Notifications ---
# Populate these with your Gmail account and App Password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
