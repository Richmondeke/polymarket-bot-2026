# --- Wallet / Blockchain ---
POLYGON_WALLET_ADDRESS=0x8E1af49c1E18fE0351791d5052c9e76200C63081
POLYGON_PRIVATE_KEY=cc5a7523b69e8de45bb8e5233503d358fbce0c2bbfc360a5151526d3159e0aee
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/ttJkYMXVkirrBeMz4EKmY

# --- Polymarket Builder API Credentials ---
# Found at: https://polymarket.com/profile → Builders section
POLY_API_KEY=019e5311-cdc1-7d78-99b7-bd93ad2a33bf
POLY_API_SECRET=VQLeTOH6RQI_j-Wv2H01UY4hjxJt3jqJlfG9u9JE9PI=
POLY_API_PASSPHRASE=2fedd9ebb636ae84f77718f36be7d0fc5a0bbbb724528b5d201fcb939fa10888

# --- Trading Mode ---
# Set LIVE_TRADING=true ONLY after successful dry-run validation.
DRY_RUN=false
LIVE_TRADING=true

# --- Position Sizing ---
POSITION_SIZE_USD=5.0         # Fixed USD per copy trade (complies with 5-share minimum)
MAX_POSITION_SIZE_USD=5.0     # Hard cap per single trade
KELLY_FRACTION=0.25           # Fractional Kelly multiplier

# --- Risk Controls ---
DAILY_STOP_LOSS_PCT=5.0       # Halt if daily P&L drops > 5%
MAX_DRAWDOWN_PCT=15.0         # Halt if total drawdown > 15%
MAX_OPEN_POSITIONS=100         # Never hold more than N positions
MAX_RESOLUTION_DAYS=1          # Filter out markets resolving in > 1 days

# --- Whale Tracker Settings ---
TOP_N_WHALES=5                # Number of whales to follow
WHALE_MIN_WIN_RATE=70         # Minimum win rate % to qualify
WHALE_MIN_VOLUME=10000        # Minimum total volume USD to qualify
WHALE_POLL_INTERVAL=60        # Seconds between trade polls per whale
LEADERBOARD_REFRESH_HOURS=6  # How often to refresh whale list

# --- Stink Bid Settings ---
STINK_BID_ENABLED=true
STINK_BID_DISCOUNT=30         # % below best ask to place bid
STINK_BID_MIN_PROB=0.65       # Only on favorites with >65% implied prob
STINK_BID_MAX_OPEN=3          # Max concurrent stink bids

# --- Dashboard ---
DASHBOARD_PORT=5000
DASHBOARD_HOST=0.0.0.0

# --- Optional: AI Scoring (Gemini) ---
GEMINI_API_KEY=
AI_SCORING_ENABLED=false

# --- Logging ---
LOG_LEVEL=INFO                # DEBUG, INFO, WARNING, ERROR
LOG_FILE=data/bot.log

# --- Email Notifications ---
# Populate these with your Gmail account and App Password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=ekerichmond@gmail.com
SMTP_PASSWORD=vwvaxodpvzqcohlx
